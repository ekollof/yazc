# All other misc crap goes here.

# Preferred editor for local and remote sessions.
# Inside Emacs (vterm) or EXWM: never nvim / full GUI — use client wrappers.
if [[ -n "$INSIDE_EMACS" || -n "$INSIDE_EXWM" || "${DESKTOP_SESSION:l}" == "exwm" || "${XDG_CURRENT_DESKTOP:l}" == *exwm* ]]; then
  if [[ -r "$HOME/.config/emacs/scripts/vterm-init.sh" ]]; then
    # Provides e/ec, emacs() guard, and EDITOR/VISUAL overrides
    # shellcheck disable=SC1091
    source "$HOME/.config/emacs/scripts/vterm-init.sh"
  else
    export EDITOR="${HOME}/bin/e"
    export VISUAL="emacsclient -a ''"
  fi
else
  export EDITOR=nvim
fi

# Keep unique PATH entries (mirror of zshrc — catches everything added below)
typeset -U path PATH

# Go (exported before use: $GOPATH/bin below must not expand to a bare /bin)
export GOPATH=$HOME/go

# PATH additions — use array form so typeset -U deduplicates automatically
path=(
  ~/bin
  ~/.config/emacs/bin
  ~/.local/bin
  ~/.cargo/bin
  ~/node_modules/.bin
  $GOPATH/bin
  $HOME/.opencode/bin  # kept here for clarity; .zshrc also adds it
  $path
)

# A dev-linked checkout must stay first: the session puts $OMARCHY_PATH/bin
# ahead of /usr/bin, and prepending user dirs above would demote it so bare
# `omarchy` resolves to the packaged copy (which refuses to run when
# OMARCHY_PATH points at a checkout).
if [[ -n ${OMARCHY_PATH:-} && $OMARCHY_PATH != /usr/share/omarchy ]]; then
  path=(${OMARCHY_PATH%/}/bin $path)
fi

# Gem user binaries. Glob the versioned directories instead of starting Ruby
# on every shell (Gem.user_dir spawns the interpreter, and the directory may
# not even exist). Covers the distro default and the older ~/.gem layout, and
# honours GEM_HOME when set.
[[ -n ${GEM_HOME:-} ]] && path+=("$GEM_HOME/bin")
for _gemdir in "$HOME"/.local/share/gem/ruby/*/bin(N/) "$HOME"/.gem/ruby/*/bin(N/); do
  path+=("$_gemdir")
done
unset _gemdir

if [[ -e ~/bin/aliases.sh ]]; then
  source ~/bin/aliases.sh
fi

# Real Kitty sets KITTY_PID and a *numeric* KITTY_WINDOW_ID.
# cosmic-term (and similar) may set KITTY_WINDOW_ID=cosmic-term only to advertise
# the Kitty graphics protocol — that is not a real Kitty window. Kittens that
# need Kitty IPC (ssh, clipboard, shell-integration, …) must not run there.
if [[ -n "$KITTY_PID" && "$KITTY_WINDOW_ID" == <-> ]]; then
  # Load kitty shell integration (marks, OSC title, cursor shape, etc.)
  # KITTY_INSTALLATION_DIR is set by kitty in the environment
  if [[ -n "$KITTY_INSTALLATION_DIR" ]]; then
    autoload -Uz -- "$KITTY_INSTALLATION_DIR/shell-integration/zsh/kitty-integration"
    kitty-integration
    unfunction kitty-integration
  fi

  # Use the kitten SSH wrapper so terminfo and features carry over to remote hosts
  # Skip when already inside an SSH session — kitten ssh only works locally.
  [[ -z "$SSH_TTY" ]] && alias ssh='kitten ssh'

  # Side-by-side diff with syntax highlighting
  alias diff='kitten diff'

  # Clipboard access (works locally and over SSH via kitten)
  alias pbcopy='kitten clipboard'
  alias pbpaste='kitten clipboard --get-clipboard'

  # Hyperlinked ripgrep — file paths in output become clickable OSC 8 links
  if command -v rg > /dev/null 2>&1; then
    alias rg='kitten hyperlinked_grep'
  fi

  # Atuin's TUI (crossterm) enables Kitty's keyboard protocol and
  # sometimes fails to pop it. Ctrl-D then arrives as CSI u instead of
  # EOF, so the shell looks wedged until the window is killed.
  _reset_kitty_keyboard() {
    printf '\e[<u' > /dev/tty 2>/dev/null
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _reset_kitty_keyboard
fi

reload_gtk() {
  local theme
  theme=$(gsettings get org.gnome.desktop.interface gtk-theme)
  gsettings set org.gnome.desktop.interface gtk-theme ''
  sleep 1
  gsettings set org.gnome.desktop.interface gtk-theme "$theme"
}

alias config='git --git-dir=$HOME/.cfg/ --work-tree=$HOME'

# KVM
export VIRSH_DEFAULT_CONNECT_URI=qemu:///system
export LIBVIRT_DEFAULT_URI=qemu:///system

# xterm transparency
if [[ -v XTERM_VERSION ]]; then
  if command -v transset-df > /dev/null 2>&1; then
    transset-df --id "$WINDOWID" 0.75 > /dev/null
  elif command -v transset > /dev/null 2>&1; then
    transset --id "$WINDOWID" 0.75 > /dev/null
  fi
fi

# Apply the terminal palette (local sessions only, skip over SSH).
#
# Omarchy is authoritative when it is running: its theme files already colour
# the terminal, and `omarchy-theme-osc` replays that same palette into windows
# that opened before a theme change (foot and tmux get the same treatment).
# Running wallust here on top of it would override the active Omarchy theme
# with a palette of its own, leaving the shell on colours Omarchy never chose.
# Only a session without Omarchy (another distro, a plain SSH host, a TTY)
# falls back to wallust and then to pywal's cached sequences.
#
# Sequences are truecolor OSC 4/11 palette sets — skip on legacy terminals
# (dtterm, vt*, …) that cannot apply them and may emit garbage instead.

# Print the active Omarchy palette as OSC sequences. Returns non-zero when
# Omarchy is absent or has never applied a theme, so callers can fall back.
_omarchy_terminal_palette() {
  local osc=
  if (( $+commands[omarchy-theme-osc] )); then
    osc=$commands[omarchy-theme-osc]
  elif [[ -n ${OMARCHY_PATH:-} && -x ${OMARCHY_PATH%/}/bin/omarchy-theme-osc ]]; then
    osc=${OMARCHY_PATH%/}/bin/omarchy-theme-osc
  elif [[ -x /usr/share/omarchy/bin/omarchy-theme-osc ]]; then
    osc=/usr/share/omarchy/bin/omarchy-theme-osc
  else
    return 1
  fi

  local colors="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
  [[ -r $colors ]] || return 1

  "$osc" "$colors"
}

if [[ ! -e ~/.noauto && -z "$SSH_TTY" ]] && _term_has_truecolor; then
  if ! _omarchy_terminal_palette; then
    if command -v wallust > /dev/null 2>&1 && [[ -f ~/.wallpaper ]]; then
      () {
        local _wseq="${XDG_CACHE_HOME:-$HOME/.cache}/wallust/sequences"
        local _wstamp="${XDG_CACHE_HOME:-$HOME/.cache}/wallust/applied.stamp"
        command mkdir -p "${_wstamp:h}"
        # Re-generate the palette only when the wallpaper changes. A full run
        # writes the cached sequences for future windows and retints this one
        # itself, so replaying the old cache here would immediately overwrite
        # the fresh palette. `-u` would retint only this terminal and never
        # refresh the cache, leaving new windows on stale colours.
        if [[ ! -f $_wseq || ! -f $_wstamp || ~/.wallpaper -nt $_wstamp ]]; then
          (wallust run -q "$(<~/.wallpaper)" && touch "$_wstamp") &!
        else
          # Replay the current palette into every new terminal window
          command cat "$_wseq"
        fi
      }
    elif [[ -f "${XDG_CACHE_HOME:-$HOME/.cache}/wal/sequences" ]]; then
      # pywal fallback for hosts without wallust.
      command cat "${XDG_CACHE_HOME:-$HOME/.cache}/wal/sequences"
    fi
  fi
fi

# fortune — interactive TTYs only (local and SSH). Skip non-interactive
# sessions (scp/rsync/tramp) and dumb terminals. OpenBSD/FreeBSD install
# fortune under /usr/games, which is often not on PATH.
if [[ -o interactive && -t 1 && "$TERM" != dumb ]]; then
  () {
    local fortune_cmd
    if (( $+commands[fortune] )); then
      fortune_cmd=$commands[fortune]
    elif [[ -x /usr/games/fortune ]]; then
      fortune_cmd=/usr/games/fortune
    else
      return
    fi
    "$fortune_cmd" -o
  }
fi

case $TERM in
  (*xterm* | rxvt* | screen* | tmux*)
    # Skip only for real Kitty outside tmux (its shell integration handles
    # titles via OSC). cosmic-term's KITTY_WINDOW_ID=cosmic-term is graphics
    # advertising only. Inside tmux the pane title is ours to set.
    if [[ -z "$KITTY_PID" || "$KITTY_WINDOW_ID" != <-> || -n "$TMUX" ]]; then
      function precmd { print -Pn "\e]0;%(1j,%j job%(2j|s|); ,)%~\a" }
      function preexec { printf "\033]0;%s\a" "$1" }
    fi
  ;;
esac

# Conditionally load mise (must load before carapace so tools are in PATH)
# Cache the init script — regenerate only when the mise binary changes.
if command -v mise > /dev/null 2>&1; then
  () {
    local _cache="${XDG_CACHE_HOME:-$HOME/.cache}/mise/init.zsh"
    local _bin="${commands[mise]}"
    command mkdir -p "${_cache:h}"
    if [[ ! -f $_cache || $_bin -nt $_cache ]]; then
      mise activate zsh >| "$_cache" 2>/dev/null
    fi
    source "$_cache"
  }
fi

# Conditionally load carapace (after mise so it can find mise-installed tools)
# Use a cached completion script — regenerate only when carapace binary changes
if command -v carapace > /dev/null 2>&1; then
  () {
    local _carapace_cache="${XDG_CACHE_HOME:-$HOME/.cache}/carapace/init.zsh"
    local _carapace_bin="${commands[carapace]}"
    command mkdir -p "${_carapace_cache:h}"
    if [[ ! -f $_carapace_cache || $_carapace_bin -nt $_carapace_cache ]]; then
      carapace _carapace zsh >| "$_carapace_cache" 2>/dev/null
    fi
    source "$_carapace_cache"
  }
fi

# Conditionally load starship (overrides custom prompt from zsh-prompt).
# Skip on limited terminals — fall back to zsh-prompt (8-color-safe).
# Cache the init script — regenerate only when the starship binary changes.
if command -v starship > /dev/null 2>&1 && _term_has_truecolor; then
  () {
    local _cache="${XDG_CACHE_HOME:-$HOME/.cache}/starship/init.zsh"
    local _bin="${commands[starship]}"
    command mkdir -p "${_cache:h}"
    if [[ ! -f $_cache || $_bin -nt $_cache ]]; then
      starship init zsh >| "$_cache" 2>/dev/null
    fi
    source "$_cache"
  }
  # starship manages the prompt — remove the vcs_info precmd hook that
  # zsh-prompt registered so it doesn't run a git process on every prompt
  # for no visible benefit.
  precmd_functions=("${(@)precmd_functions:#precmd_vcs_info}")
fi

# Conditionally load zoxide (smarter cd)
# Cache the init script — regenerate only when the zoxide binary changes.
if command -v zoxide > /dev/null 2>&1; then
  () {
    local _cache="${XDG_CACHE_HOME:-$HOME/.cache}/zoxide/init.zsh"
    local _bin="${commands[zoxide]}"
    command mkdir -p "${_cache:h}"
    if [[ ! -f $_cache || $_bin -nt $_cache ]]; then
      zoxide init zsh >| "$_cache" 2>/dev/null
    fi
    source "$_cache"
  }
fi

# Store/retrieve git credential prompts via ksshaskpass when available and a
# graphical session can show its dialog. Over SSH without a display, leave the
# normal tty prompt in place (a stale DISPLAY from X11 forwarding would make
# ssh try ksshaskpass and fail instead of prompting).
if [[ -x /usr/bin/ksshaskpass && -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
  export SSH_ASKPASS=/usr/bin/ksshaskpass
  export SSH_ASKPASS_REQUIRE=prefer
  export GIT_ASKPASS=/usr/bin/ksshaskpass
fi

# SSH agent selection. A working inherited agent is authoritative — notably a
# forwarded agent (`ssh -A`), which must not be replaced by the local keyring
# or the forwarded keys disappear. Only start gcr-ssh-agent/keychain when
# there is no usable agent.
#
# Wrapped in an anonymous function so its helper, arrays, and loop variables
# do not leak into the interactive shell's global scope.
() {
  # ssh-add -l exits 0 with keys, 1 for a reachable but empty agent, and 2
  # when the socket is dead.
  _ssh_agent_ok() {
    local rc
    [[ -n ${SSH_AUTH_SOCK:-} ]] || return 1
    ssh-add -l &>/dev/null
    rc=$?
    (( rc != 2 ))
  }
  _ssh_agent_has_keys() {
    [[ -n ${SSH_AUTH_SOCK:-} ]] || return 1
    ssh-add -l &>/dev/null
  }

  # gcr-ssh-agent is socket-activated and has no separate agent PID.
  if [[ ${SSH_AUTH_SOCK:-} == ${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh ]]; then
    unset SSH_AGENT_PID
  fi

  # In an SSH session, an inherited agent was forwarded by the client: keep
  # it even when it is empty (`ssh -A` means the client's keys, not ours).
  # A dead forwarded socket falls through to the local agent below.
  if [[ -n ${SSH_CONNECTION:-} ]] && _ssh_agent_ok; then
    return 0
  fi
  _ssh_agent_has_keys && return 0

  local started=0
  if [[ -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh ]]; then
    # gcr-ssh-agent (systemd --user socket) preloads keys from ~/.ssh and
    # stores unlock passphrases in the login keyring. PAM unlocks the keyring
    # with the login password at login, so keys work with no prompting.
    export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh"
    unset SSH_AGENT_PID
    started=1
  elif (( $+commands[keychain] )); then
    # Fallback for hosts without gcr-ssh-agent: funtoo keychain.

    # Drop stale agent env left over from a previous login (the socket can
    # outlive the process → "Error connecting to agent: Connection refused").
    unset SSH_AUTH_SOCK SSH_AGENT_PID
    rm -f "$HOME/.keychain/$HOST-sh" "$HOME/.keychain/$HOST-csh" "$HOME/.keychain/$HOST-fish" 2>/dev/null

    # Private keys, including symlinked ones (1Password/KeePass/age setups).
    # (N) is nullglob; -f follows symlinks, so the regular-file-only (.)
    # qualifier would wrongly skip a key that is a symlink.
    local -a keys=()
    local key
    for key in "$HOME"/.ssh/id_*(N); do
      [[ $key == *.pub || ! -f $key ]] && continue
      keys+=("$key")
    done

    # --immediate: skip "Press Enter to initialize keys" coordination prompt.
    # Older keychain (e.g. 2.8.x on OpenBSD) lacks the option, and 3.x doesn't
    # mention action options in --help, so probe by parsing options only:
    # unknown options exit 1 before keychain does anything; --version exits 0.
    if (( ${#keys} )); then
      local -a args=(-q)
      keychain --immediate --version >/dev/null 2>&1 && args+=(--immediate)
      keychain "${args[@]}" "${keys[@]}"
    fi
    if [[ -e "$HOME/.keychain/$HOST-sh" ]]; then
      source "$HOME/.keychain/$HOST-sh"
      started=1
    fi
  fi

  (( started )) || return 0

  # This shell selected a local agent, so publish it to the systemd user
  # manager and dbus activation environment for processes started outside this
  # shell. Never do this for a forwarded agent: its socket dies with the SSH
  # connection.
  #
  # systemctl --user needs a running systemd user manager — not on *BSD, not on
  # Linux without systemd, not before pam_systemd has created the runtime dir.
  if [[ -n ${SSH_AUTH_SOCK:-} ]] && command -v systemctl > /dev/null 2>&1 \
    && [[ -d ${XDG_RUNTIME_DIR:-/run/user/$UID}/systemd ]]; then
    systemctl --user set-environment SSH_AUTH_SOCK="$SSH_AUTH_SOCK"
  fi
  if [[ -n ${SSH_AUTH_SOCK:-} ]] && command -v dbus-update-activation-environment > /dev/null 2>&1; then
    # Only call it when a session bus is actually reachable — otherwise it
    # tries to autolaunch dbus-daemon, which fails on headless sessions
    # (e.g. SSH to FreeBSD: "Unable to autolaunch a dbus-daemon without a
    # $DISPLAY for X11"). The user-bus socket check covers systemd SSH
    # sessions where DBUS_SESSION_BUS_ADDRESS is not yet set.
    if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} || -S ${XDG_RUNTIME_DIR:-/run/user/$UID}/bus ]]; then
      dbus-update-activation-environment SSH_AUTH_SOCK="$SSH_AUTH_SOCK"
    fi
  fi
}
