#compdef omakit
# omakit completion for zsh, omakit 0.6.12, marketplace pin bdf24b347fcb2fb7a0af18104ab68dc6ecbf9882.
# Generated by `omakit setup`; the categories and tags below are that pin's
# submission form and the commands are that version's. Regenerate it by
# running setup again.

_omakit() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a commands categories tags shells
  commands=(
    'add:Copy a block into the plugin'\''s omakit/ directory\: run (Run.qml and the supervisor it starts by absolute path) or store (Store.qml and its helper, with run, which it uses), and NOTICE, each file with a header naming the block, its version, the licence, the omakit commit and the body'\''s sha256.'
    'inspect:What a plugin tree does, as observations\: every process with its argv, every host with its timeout and size-cap flags, every write with whether it falls under a directory the plugin controls, every timer with its interval, and the capabilities the marketplace baseline records.'
    'verify:The official marketplace security baseline over the local Git transport, reported verbatim beside the pin identity.'
    'submit:Every check that is knowable before submitting, the resolved commit, and the exact issue title and body.'
    'watch:Compare the commit the marketplace validated on a submission issue with the plugin repository'\''s current default-branch HEAD, and say what makes it validate a newer one.'
    'lab:Prove a suite in a disposable Omarchy guest, never on the desktop\: an Omarchy release booted from an immutable verified base, a fresh overlay per run, the guest'\''s installed omarchy package read and printed before the suite, the document written with that identity.'
    'audit:Compare every installed third-party plugin'\''s running commit with the exact commits the marketplace records as validated.'
    'weigh:What a plugin weighs on the shell, measured\: the shell is restarted without it and with it, several runs, and the difference is the weight, with the baseline'\''s own spread as the noise floor; memory is printed as the shell'\''s own startup variance, CPU and child processes as the weight.'
    'doctor:What is installed, what is pinned, and what has moved since.'
    'setup:First run, in one command\: check the environment, fetch the pinned marketplace checkout, install tab completion and prove it in a new shell, and say what to try first.'
    'pin:Fetch or verify the pinned marketplace checkout in the user cache\: $XDG_CACHE_HOME/omakit/marketplace, or ~/.cache/omakit/marketplace.'
    'upgrade:Update omakit through the installer that made it\: npm, at the exact version the registry names, or a fast-forward of a clone.'
    'parity:The official baseline over GitHub versus the local transport on real listed repositories; a packaged install requires --out for evidence.'
    'help:The operating instructions for a coding agent, printed from skills/, so an agent can read the contract out of the tool instead of the repository.'
  )
  categories=('Appearance' 'Desktop' 'Developer Tools' 'Hardware' 'Kids' 'Productivity' 'System' 'Widgets' 'Other')
  tags=('ai' 'bar' 'education' 'games' 'hyprland' 'kids' 'launcher' 'media' 'power-management' 'quickshell' 'security' 'system' 'vpn' 'workspaces')
  _arguments -C '1:command:->command' '*::arguments:->arguments'
  case "$state" in
  command)
    _describe -t commands 'omakit command' commands
    ;;
  arguments)
    case "$line[1]" in
    add)
      _arguments '--update' '--json' '1:block:(run store)' '2:plugin directory:_directories'
      ;;
    inspect)
      _arguments '--full' '--json' '--out:file:_files' '--offline' '--allow-dirty' '1:target:_directories'
      ;;
    verify)
      _arguments '--allow-dirty' '--json' '--out:file:_files' '1:target:_directories'
      ;;
    submit)
      _arguments '--category:category:{compadd -a categories}' '--tags:tags:{_values -s , tag $tags}' '--notes:text:' '--suggest-tag:text:' '--name:text:' '--offline' '--allow-dirty' '--json' '--out:file:_files' '--body-out:file:_files' '1:target:_directories'
      ;;
    watch)
      _arguments '--json' '--out:file:_files' '--all' '--list' '--user:text:'
      ;;
    lab)
      _arguments '--runs:text:' '--offline' '--json' '--out:file:_files' '--verify' '--from:file:_files' '--toolchain:text:' '--plugins' '--yes' '--keep-iso' '--records' '1:action:(prove inspect setup prune)' '2:suite:(run store weigh weigh-evidence)'
      ;;
    audit)
      _arguments '--drift' '--json' '--out:file:_files' '--offline' '1:plugin:_omakit_plugins'
      ;;
    weigh)
      _arguments '--runs:text:' '--window:text:' '--settle:text:' '--yes' '--json' '--out:file:_files' '--all' '--list' '1:plugin:_omakit_plugins'
      ;;
    doctor)
      _arguments '--offline' '--json' '--out:file:_files'
      ;;
    setup)
      _arguments '--yes' '--completion'
      ;;
    pin)
      ;;
    upgrade)
      _arguments '--dry-run'
      ;;
    parity)
      _arguments '--count:text:' '--offset:text:' '--out:file:_files'
      ;;
    help)
      _arguments '--agent'
      ;;
    esac
    ;;
  esac
}

# The plugin ids the running shell has installed, enabled first, whole bars
# left out, read at TAB time; a directory when the shell does not answer.
_omakit_plugins() {
  local -a ids
  if (( $+commands[timeout] )); then ids=(${(f)"$(timeout 1 omarchy-shell shell listPlugins 2>/dev/null | jq -r '[.[] | select(((.kinds // []) | index("bar")) | not)] | sort_by(.enabled | not) | .[].id' 2>/dev/null)"}); else ids=(${(f)"$(omarchy-shell shell listPlugins 2>/dev/null | jq -r '[.[] | select(((.kinds // []) | index("bar")) | not)] | sort_by(.enabled | not) | .[].id' 2>/dev/null)"}); fi
  if (( ${#ids} )); then compadd -a ids; else _directories; fi
}

_omakit "$@"
